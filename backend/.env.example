PORT=4000
MONGO_URL=mongodb://localhost:27017/recruiter
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Used to build booking links sent to candidates
FRONTEND_URL=http://localhost:5173

# AI provider: anthropic | openai. Only the selected provider's key is required.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional USD per 1M tokens for cost tracking (built-in prices cover the default Claude models only)
LLM_INPUT_PRICE=
LLM_OUTPUT_PRICE=

# Optional: web sourcing via Serper. Without it, Claude's web search is used (LLM_PROVIDER=anthropic);
# with neither, sourcing uses CSV uploads only (no candidates are ever invented).
SERPER_API_KEY=

# Optional: real email (e.g. smtps://user:pass@smtp.mailtrap.io:465 or an Ethereal account). Without it, emails are logged.
SMTP_URL=
MAIL_FROM=Recruiter <recruiter@example.com>

# One outreach "day" in ms. 60000 makes Day 3 / Day 7 follow-ups fire after 3 / 7 minutes for demos.
OUTREACH_DAY_MS=86400000
DAILY_SEND_LIMIT=50
